[Unit]
Description=KDictate core daemon
# graphical-session.target is what exports WAYLAND_DISPLAY into the systemd
# user environment. Pulling the daemon in from default.target instead starts
# it at user-manager time, before that export happens -- "After=" alone does
# not wait for a target nothing else has ordered us against. The daemon then
# holds an environment with no display for its whole lifetime, and every
# "ibus" CLI call it makes resolves the wrong bus socket and fails (see the
# _DISPLAY_ENV_KEYS comment in kdictate/core/ibus.py).
PartOf=graphical-session.target
After=graphical-session.target sound.target

[Service]
Type=simple
WorkingDirectory=@@REPO_DIR@@
ExecStart=@@REPO_DIR@@/.venv/bin/kdictate-daemon@@BACKEND_FLAGS@@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
